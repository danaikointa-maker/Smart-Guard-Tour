#!/bin/sh
# Gradle wrapper launcher (jar: gradle/wrapper/gradle-wrapper.jar — สร้างอัตโนมัติด้วย `gradle wrapper`
# หรือ `flutter create --platforms=android .` บนเครื่องที่มี Flutter SDK ถ้ายังไม่มี)
DIRNAME=$(dirname "$0")
exec java -classpath "$DIRNAME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
